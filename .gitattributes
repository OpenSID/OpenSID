.gitignore merge=ours

# Autodetect file teks
* text=auto

# Perlakukan file - file ini sebagai teks
*.php  text
*.css  text
*.js   text
*.txt  text
*.md   text
*.xml  text
*.json text
*.sql  text
*.yml  text

# Pastikan file - file ini tidak diutak-atik
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.rtf   binary

# Jangan sertakan file dan folder ini ke rilis
/.github               export-ignore
/.editorconfig         export-ignore
/*.cache               export-ignore
/*.log.php             export-ignore
/.php-cs-fixer.php     export-ignore
/.prettierrc.json      export-ignore
/package-lock.json     export-ignore
/package.json          export-ignore
/phpunit.xml           export-ignore
/phpunit.xml.dist      export-ignore
/playwright.config.ts  export-ignore
/rector.php            export-ignore
/tests                 export-ignore
/documents             export-ignore
/tsconfig.json         export-ignore
/.e2e.env              export-ignore
/.e2e.env.example      export-ignore
/.env                  export-ignore
/.env.example          export-ignore
/.env.testing.example  export-ignore
/.kilo                 export-ignore
/.playwright-mcp       export-ignore
/.phpunit.result.cache export-ignore
/node_modules          export-ignore
/test-results          export-ignore
/phpstan-baseline.neon export-ignore
/phpstan-security.neon export-ignore
/phpstan-bootstrap.php export-ignore
/phpstan.neon.dist     export-ignore
/vite.config.js        export-ignore
/_ide_helper.php       export-ignore
/.dockerignore         export-ignore
/.devcontainer         export-ignore
/bin                   export-ignore

