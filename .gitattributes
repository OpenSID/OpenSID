.gitignore merge=ours

# Autodetect file teks
* text=auto

# Perlakukan file - file ini sebagai teks
*.php  text
*.css  text
*.js   text
*.txt  text
*.md   text
*.xml  text
*.json text
*.sql  text
*.yml  text

# Pastikan file - file ini tidak diutak-atik
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.rtf   binary

# Jangan sertakan file dan folder ini ke rilis
/.github              export-ignore
/.editorconfig        export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
/*.cache              export-ignore
/*.log.php            export-ignore
/.php-cs-fixer.php    export-ignore
/.prettierrc.json     export-ignore
/make_obfuscate.php   export-ignore
/umum_obfuscate.php   export-ignore
/package-lock.json    export-ignore
/package.json         export-ignore
/phpunit.xml          export-ignore
/phpunit.xml.dist     export-ignore
/playwright.config.ts export-ignore
/rector.php           export-ignore
/tests                export-ignore
/dev-seed             export-ignore
/documents            export-ignore
# Adapter/marketplace sumber modul khusus-pengembangan (simulasi Layanan dari
# repo lokal); tak ikut rilis — guard class_exists → jatuh ke LayananHttpSource.
/app/Services/Module/LocalRepoSource.php export-ignore
/app/Services/Module/LocalMarketplace.php export-ignore
# Emulator Layanan lokal (simulasi server Layanan dari gudang lokal) — dev-only,
# tak ikut rilis; aktif saat "Sumber paket" = bursa lokal. Guard class_exists +
# ENVIRONMENT di hooks.php/AppServiceProvider → rilis jatuh ke Layanan nyata.
/app/Services/Layanan/LocalLayanan.php export-ignore
/app/Services/Layanan/PengalihLayananLokal.php export-ignore
/donjo-app/controllers/Layanan_lokal.php export-ignore
# Tab dev "Sumber" pada Paket Tambahan (controller + rute + view) — dev-only, tak ikut rilis.
/donjo-app/controllers/Dev_modul.php export-ignore
/donjo-app/Routes/Web/dev.php export-ignore
/resources/views/admin/dev_modul export-ignore
