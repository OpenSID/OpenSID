# Abaikan file
*.log
log-*.php
**/.DS_Store
sftp-config.json
.php-cs-fixer.cache
# /.htaccess root DILACAK Git: forwarder ke public/ agar instalasi lama yang
# memperbarui lewat `git pull` tetap hidup tanpa aksi manual (premium#7083).
# public/.htaccess juga DILACAK Git mengikuti pola Laravel standar.
*.sql
*.sql.gz
# Berkas SQL untuk database tes Playwright wajib ikut ter-commit
!tests/playwright/storage/database/schema.sql
!tests/playwright/storage/database/seed.sql
mitra
generate-route.php

# Abaikan file cache milik phpintel (plugin sublime text)
