# Abaikan folder desa
desa/*

# Abaikan file
*.log
log-*.php
**/.DS_Store
sftp-config.json
.php-cs-fixer.cache
/.htaccess
*.sql
*.sql.gz
# dev-seed: data awal DEV — di-track ke branch, tapi dikecualikan dari arsip rilis
# lewat `.gitattributes` (export-ignore). Kecualikan dari aturan *.sql di atas.
!/dev-seed/*.sql
mitra
generate-route.php
index.php

# Abaikan file cache milik phpintel (plugin sublime text)
.phpintel/*
.idea/*

# Abaikan file milik library Release dan Curly
*.pem
version.json

# obfuscator
Obfuscator.php

# Abaikan isian folder vendor
vendor/codeigniter/framework/*
!vendor/codeigniter/framework/system/

# Abaikan dokumentasi
vendor/*/*/.github
vendor/*/*/*.md
!vendor/*/*/catatan_rilis.md
vendor/*/*/*.TXT
vendor/*/*/*.cache
vendor/*/*/*.yml
vendor/*/*/*.dist
vendor/*/*/*.xml
vendor/*/*/.gitignore
vendor/*/*/LICENSE
vendor/*/*/tests/
test
doc/
docs/
example/
examples/
/tools/

vendor/tinymce/*
vendor/_laravel_ide
vendor/libreoffice/*
vendor/mikey179/*

# Dev-only dependencies (installed via require-dev, tidak di-commit)
vendor/bin/php-cs-fixer
vendor/bin/php-parse
vendor/bin/phpstan
vendor/bin/phpstan.phar
vendor/bin/phpunit
vendor/bin/rector
vendor/bin/validate-json
vendor/clue/
vendor/composer/pcre/
vendor/composer/semver/
vendor/composer/xdebug-handler/
vendor/doctrine/instantiator/
vendor/ergebnis/
vendor/evenement/
vendor/fakerphp/
vendor/fidry/
vendor/friendsofphp/
vendor/hamcrest/
vendor/justinrainbow/
vendor/localheinz/
vendor/marc-mabe/
vendor/mockery/
vendor/myclabs/
vendor/nikic/
vendor/phar-io/
vendor/phpstan/
vendor/phpunit/
vendor/react/
vendor/rector/
vendor/sebastian/
vendor/symfony/filesystem/
vendor/symfony/options-resolver/
vendor/symfony/polyfill-php81/
vendor/symfony/polyfill-php84/
vendor/symfony/stopwatch/
vendor/theseer/
.vscode/*
/node_modules
.cache-rector/*
!.cache-rector/.gitkeep

# Artefak emulator bursa lokal (data runtime, tumbuh saat dev-marketplace jalan)
storage/app/dev-marketplace/

storage/framework/cache/*
storage/framework/views/*
storage/framework/sessions/*
storage/logs

!storage/framework/cache/.gitkeep
!storage/framework/views/.gitkeep
!storage/framework/sessions/.gitkeep

php.ini

# Ignore all symlink folder
/assets/modules/*
/assets/themes/*

# Ignore all files in Modules
Modules/*
/assets/modules/*

# Do not ignore Anjungan folder and its contents
!Modules/Anjungan/
!Modules/Anjungan/**
!Modules/Analisis/
!Modules/Analisis/**
!Modules/Kehadiran/
!Modules/Kehadiran/**
!Modules/Lapak/
!Modules/Lapak/**
!Modules/Pelanggan/
!Modules/Pelanggan/**

# Do not ignore specific files
!Modules/.gitkeep
!Modules/.htaccess
!Modules/index.html

# Catatan pengembang lokal (tidak ikut rilis)
/dokumentasi_lokal

# Ignore PHPUnit result cache file
.phpunit.result.cache

# ignore favicon.ico
/favicon.ico

# Node.js dependencies
node_modules/

# Ignore Playwright storage
tests/playwright/storage/*

# Do not ignore Playwright storage contains
!tests/playwright/storage/database/
!tests/playwright/storage/fixtures/

# Ignore Playwright test reports
tests/playwright/test-results/
tests/playwright/report/
tests/playwright/blob-report/
test-results/

# Playwright cache directory (improves test performance)
tests/playwright/.cache/

# Environment configuration (store secrets locally, not in Git)
tests/playwright/.env
.playwright-mcp
.e2e.env

# Testing vendor directory (separate from production)
tests/vendor/
.phpunit.cache/
tests/.phpunit.cache/
