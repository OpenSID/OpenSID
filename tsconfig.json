{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": "./tests/playwright",
    "paths": {
      "@test/e2e/regression/*": ["e2e/regression/*"],
      "@test/e2e/smoke/*": ["e2e/smoke/*"],
      "@test/storage/*": ["storage/*"],
      "@test/utils/*": ["utils/*"]
    },
    "outDir": "./tests/playwright/dist"
  },
  "include": ["tests/playwright/**/*"]
}
